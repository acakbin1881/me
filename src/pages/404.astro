---
import Layout from '../layouts/Layout.astro';
import Masthead from '../components/Masthead.astro';
import Stair from '../components/Stair.astro';
import { url } from '../lib/url';
---

<Layout title="Not found - Aras Akbin">
  <div class="side side-a">
    <Masthead />
    <section class="hero wrap">
      <div class="hero-inner">
        <Stair as="h1" name="This page" lines={['is on neither', 'side of', 'the sheet.']} class="is-intro" />
        <div class="hero-foot">
          <p><a href={url('/')} class="hl is-underlined">Back to the front</a></p>
        </div>
      </div>
    </section>
  </div>
</Layout>
