---
import '../styles/global.css';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  /** Path under /public, e.g. "/og.png" (1200x630). */
  image?: string;
  lang?: string;
}

const {
  title = 'TODO: Ad Soyad',
  description = 'TODO: one-sentence description shown in search results and link previews.',
  image = '/og.png',
  lang = 'tr',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url(image), Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="icon" href={url('/favicon.ico')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta name="generator" content={Astro.generator} />

    <!-- Link previews (LinkedIn, X, WhatsApp, Slack) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <slot name="head" />
  </head>
  <body class="min-h-dvh">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-surface focus:px-3 focus:py-2"
    >
      İçeriğe geç
    </a>
    <main id="main">
      <slot />
    </main>
  </body>
</html>
